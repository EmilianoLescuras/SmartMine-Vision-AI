# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Environments ──────────────────────────────────────────────────────────────
.env
.venv/
venv/
env/
*.env.local

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.nbconvert.ipynb

# ── Model Weights (large binaries — store in DVC or cloud storage) ────────────
models/**/*.pt
models/**/*.pth
models/**/*.onnx
models/**/*.engine
!models/**/README.md
# Stray pretrained weights downloaded by ultralytics
*.pt

# ── Training run artifacts (re-generated; do not commit) ──────────────────────
runs/
**/runs/
experiments/**/*
!experiments/**/README.md
!experiments/.gitkeep

# ── Datasets (large files — document sources, do not commit raw data) ─────────
datasets/raw/**/*
datasets/processed/**/*
datasets/merged/**/*
!datasets/raw/**/README.md
!datasets/processed/.gitkeep
!datasets/merged/.gitkeep
!datasets/raw/ppe/.gitkeep
!datasets/raw/vehicles/.gitkeep
!datasets/raw/custom/.gitkeep
# Un-ignore vehicle source subdirectories (directories first, then .gitkeep)
!datasets/raw/vehicles/construction_vehicles/
!datasets/raw/vehicles/construction_vehicles/.gitkeep
!datasets/raw/vehicles/mining_area_detection/
!datasets/raw/vehicles/mining_area_detection/.gitkeep
!datasets/raw/vehicles/riskalert/
!datasets/raw/vehicles/riskalert/.gitkeep
!datasets/raw/vehicles/riskalertai/
!datasets/raw/vehicles/riskalertai/.gitkeep

# ── Outputs ───────────────────────────────────────────────────────────────────
outputs/images/**/*
outputs/videos/**/*
outputs/logs/**/*
!outputs/**/README.md
!outputs/**/.gitkeep

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ── MLflow ────────────────────────────────────────────────────────────────────
mlruns/
mlartifacts/

# ── Docker ────────────────────────────────────────────────────────────────────
*.pid

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
Thumbs.db
